{
  "name": "hgl-wms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lockfile:check": "npm ci --ignore-scripts && git diff --exit-code -- package-lock.json",
    "migrations:check": "node scripts/check-migrations.mjs",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint",
    "lint:backend": "eslint app/api lib scripts tests/integration tests/unit/auditService.test.ts tests/unit/licensePolicy.test.ts tests/unit/notificationMessages.test.ts tests/unit/notificationService.test.ts tests/unit/rbac.test.ts",
    "biome:check": "biome ci biome.json playwright.config.ts tests/e2e docs/openapi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:backend": "vitest run tests/integration tests/unit/auditService.test.ts tests/unit/licensePolicy.test.ts tests/unit/notificationMessages.test.ts tests/unit/notificationService.test.ts tests/unit/rbac.test.ts",
    "test:e2e:smoke": "playwright test --project=chromium",
    "openapi:types": "openapi-typescript docs/openapi/openapi.json -o lib/api/openapi-types.ts",
    "openapi:check": "openapi-typescript docs/openapi/openapi.json -o lib/api/openapi-types.ts --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepush": "npm run lockfile:check && npm run migrations:check && npm run typecheck && npm run biome:check && npm run lint:backend && npm test && npm run test:backend && npm run openapi:check && npm audit --omit=dev --audit-level=high && npm run build",
    "prepare": "husky",
    "seed": "npx tsx scripts/seed/seed_data.ts",
    "report:emails": "npx tsx scripts/reports/email-activity-report.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{json,md,yml,yaml,css}": "prettier --write",
    "biome.json": "biome check --write",
    "playwright.config.ts": "biome check --write",
    "tests/e2e/**/*": "biome check --write",
    "docs/openapi/**/*": "biome check --write"
  }
}
