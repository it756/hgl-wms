{
  "openapi": "3.1.0",
  "info": {
    "title": "HGL WMS API",
    "version": "0.1.0",
    "description": "Committed API contract snapshot used by the frontend OpenAPI drift check."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/bu/catalogue": {
      "get": {
        "operationId": "searchSbuCatalogue",
        "description": "Active SBU catalogue products, including zero-stock items. BU_MANAGER and UNIT_STAFF are scoped to their authenticated profile. Privileged roles must supply sbu_id. Cursor order is (name, id).",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque continuation token, bound to SBU and search.",
            "schema": { "type": "string" }
          },
          { "name": "sbu_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Bounded catalogue page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CataloguePage" } }
            }
          },
          "400": { "description": "Invalid query or cursor" },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Forbidden role" },
          "422": { "description": "Missing or invalid account SBU assignment" },
          "500": { "description": "Catalogue retrieval failed" }
        }
      }
    },
    "/transfer-requests": {
      "get": {
        "operationId": "listTransferRequests",
        "responses": {
          "200": {
            "description": "Transfer requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferRequest"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTransferRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created transfer request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "responses": {
          "200": {
            "description": "Notifications for the authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Notification"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/return-requests": {
      "get": {
        "operationId": "listReturnRequests",
        "responses": {
          "200": {
            "description": "Return requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReturnRequest"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogueProduct": {
        "type": "object",
        "required": ["id", "name", "sku", "uom", "unit_cost", "stock_quantity"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "sku": { "type": "string" },
          "uom": { "type": "string" },
          "unit_cost": { "type": ["number", "null"] },
          "stock_quantity": { "type": "integer" }
        }
      },
      "CataloguePage": {
        "type": "object",
        "required": ["items", "nextCursor", "hasMore"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CatalogueProduct" }
          },
          "nextCursor": { "type": ["string", "null"] },
          "hasMore": { "type": "boolean" }
        }
      },
      "CreateTransferRequest": {
        "type": "object",
        "required": ["requesting_unit_id", "lines"],
        "properties": {
          "requesting_unit_id": {
            "type": "string",
            "format": "uuid"
          },
          "required_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "notes": {
            "type": ["string", "null"]
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferRequestLineInput"
            },
            "minItems": 1
          }
        }
      },
      "TransferRequestLineInput": {
        "type": "object",
        "required": ["product_id", "requested_quantity"],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "requested_quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ReferenceResponse": {
        "type": "object",
        "required": ["id", "reference_number"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference_number": {
            "type": "string"
          }
        }
      },
      "TransferRequest": {
        "type": "object",
        "required": ["id", "reference_number", "status"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference_number": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ReturnRequest": {
        "type": "object",
        "required": ["id", "reference_number", "status"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference_number": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Notification": {
        "type": "object",
        "required": ["id", "type", "message", "is_read"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "is_read": {
            "type": "boolean"
          },
          "related_entity_id": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
